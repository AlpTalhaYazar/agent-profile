{
  "name": "@agent-profile/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Electron Main + Renderer host for the Agent Profile daemon and GUI.",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "build": "electron-forge package",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "verify-fuses": "node ./scripts/verify-fuses.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "electron-forge package && playwright test --config test/e2e/playwright.config.ts",
    "test:watch": "vitest",
    "lint": "biome check src test scripts"
  },
  "dependencies": {
    "@agent-profile/capability": "workspace:*",
    "@agent-profile/cli-services": "workspace:*",
    "@agent-profile/core": "workspace:*",
    "@agent-profile/ipc-protocol": "workspace:*",
    "@agent-profile/persona-deployer": "workspace:*",
    "@agent-profile/secrets": "workspace:*",
    "@agent-profile/ui": "workspace:*",
    "@homebridge/node-pty-prebuilt-multiarch": "0.13.1",
    "@xterm/xterm": "^6.0.0",
    "jotai": "^2.10.1",
    "lucide-react": "^1.14.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/plugin-fuses": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.0",
    "autoprefixer": "^10.4.20",
    "electron": "^35.0.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
