{
  "name": "@agent-profile/ipc-protocol",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./messages": {
      "types": "./dist/messages.d.ts",
      "import": "./dist/messages.js"
    },
    "./messages/system": {
      "types": "./dist/messages/system.d.ts",
      "import": "./dist/messages/system.js"
    },
    "./messages/auth": {
      "types": "./dist/messages/auth.d.ts",
      "import": "./dist/messages/auth.js"
    },
    "./messages/profile": {
      "types": "./dist/messages/profile.d.ts",
      "import": "./dist/messages/profile.js"
    },
    "./messages/sessions": {
      "types": "./dist/messages/sessions.d.ts",
      "import": "./dist/messages/sessions.js"
    },
    "./messages/secrets": {
      "types": "./dist/messages/secrets.d.ts",
      "import": "./dist/messages/secrets.js"
    },
    "./messages/persona": {
      "types": "./dist/messages/persona.d.ts",
      "import": "./dist/messages/persona.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test"
  },
  "dependencies": {
    "@agent-profile/capability": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "files": ["dist"]
}
